# Example Environment Variables Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file with real credentials!

# ============================================
# GCP Configuration (Optional)
# ============================================
# Only needed if using real GCP data via APIs
# Leave empty to use synthetic data

# GCP Project ID for data collection
GCP_PROJECT_ID=

# Path to GCP service account key JSON file
# Create a service account with read-only permissions
# See: docs/REAL_DATA_INTEGRATION.md
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================
# AWS Configuration (Optional)
# ============================================
# Only needed if using real AWS data via APIs
# Leave empty to use synthetic data

# AWS Access Key ID (read-only IAM user recommended)
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=

# AWS Region for API calls
AWS_REGION=us-east-1

# ============================================
# Data Collection Settings (Optional)
# ============================================

# Enable real data collection (true/false)
# When false, uses synthetic data
USE_REAL_DATA=false

# Cache duration for API data (in seconds)
CACHE_DURATION=3600

# ============================================
# SECURITY NOTES
# ============================================
# 1. This file (.env.example) is safe to commit
# 2. Your actual .env file should NEVER be committed
# 3. Use read-only credentials with minimal permissions
# 4. Consider using a test/sandbox account
# 5. See docs/REAL_DATA_INTEGRATION.md for security best practices
